@@ -0,0 +1,75 @@
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+#include <math.h>
+
+// Small, hardware-independent policies shared with the host regression tests.
+namespace PowerSaving {
+
+inline float meanTemperature(const float* samples, size_t count) {
+  if (!samples || count == 0) return NAN;
+  float sum = 0.0f;
+  for (size_t i = 0; i < count; ++i) {
+    if (!isfinite(samples[i]) || samples[i] < -40.0f || samples[i] > 125.0f) return NAN;
+    sum += samples[i];
+  }
+  return sum / (float)count;
+}
+
+inline uint32_t beforeDeadline(uint32_t now, uint32_t deadline, uint32_t maximum) {
+  if (deadline == 0) return maximum;
+  int32_t remaining = (int32_t)(deadline - now);
+  if (remaining <= 0) return 0;
+  return (uint32_t)remaining < maximum ? (uint32_t)remaining : maximum;
+}
+
+inline uint32_t idleDelay(uint32_t now, bool radioPending, uint32_t contactsDue,
+                          uint32_t aclDue, bool bleReadPending, bool blePacing) {
+  if (radioPending || bleReadPending) return 0;
+  uint32_t delay = blePacing ? 1 : 10;
+  delay = beforeDeadline(now, contactsDue, delay);
+  return beforeDeadline(now, aclDue, delay);
+}
+
+inline int chargeMilliAmps(uint8_t code) {
+  code &= 0x1F;
+  if (code > 16) return -1; // Reserved on the linear-charger AXP2101.
+  return code <= 8 ? code * 25 : 200 + (code - 8) * 100;
+}
+
+inline int inputMilliAmps(uint8_t code) {
+  const int values[] = {100, 500, 900, 1000, 1500, 2000};
+  code &= 7;
+  return code < 6 ? values[code] : -1;
+}
+
+// Backoff is extra supervision, not battery-temperature protection. Hardware
+// thermal/input regulation remains responsible even when the CPU is stopped.
+inline bool chargeBackoff(bool wasLimited, bool valid, float pmuTemperature,
+                          bool thermalLimited, bool inputLimited, bool external,
+                          uint16_t vbusMv) {
+  if (!valid || !isfinite(pmuTemperature)) return true;
+  if (!external) return wasLimited;
+  if (thermalLimited || inputLimited || pmuTemperature >= 80.0f || vbusMv < 4500) return true;
+  if (wasLimited && (pmuTemperature > 70.0f || vbusMv < 4750)) return true;
+  return false;
+}
+
+// Require a full minute of healthy samples before restoring 1 A. A weak cable
+// must not make the charger alternate between 500 mA and 1 A every sample.
+class ChargeRecovery {
+  bool _recovering = false;
+  uint32_t _since = 0;
+public:
+  bool limit(bool requested, bool wasLimited, bool external, uint32_t now) {
+    if (requested || !external) { _recovering = false; return requested || wasLimited; }
+    if (!wasLimited) { _recovering = false; return false; }
+    if (!_recovering) { _recovering = true; _since = now; }
+    if ((uint32_t)(now - _since) < 60000) return true;
+    _recovering = false;
+    return false;
+  }
+};
+
+} // namespace PowerSaving
