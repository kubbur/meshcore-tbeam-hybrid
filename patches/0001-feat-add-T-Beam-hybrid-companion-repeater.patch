 uint8_t MyMesh::onContactRequest(const ContactInfo &contact, uint32_t sender_timestamp, const uint8_t *data,
                                  uint8_t len, uint8_t *reply) {
+#ifdef HYBRID_REMOTE_ADMIN
+  ClientInfo* admin = admin_acl.getClient(contact.id.pub_key, PUB_KEY_SIZE);
+  if (admin && len > 0) {
+    if (sender_timestamp <= admin->last_timestamp) {
+      MESH_DEBUG_PRINTLN("Hybrid admin: possible request replay attack");
+      return 0;
+    }
+
+    uint8_t reply_len = handleAdminRequest(admin, sender_timestamp, data, len);
