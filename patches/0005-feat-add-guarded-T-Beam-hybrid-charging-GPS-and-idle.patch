diff --git a/variants/lilygo_tbeam_SX1276/TBeamGpsProvider.h b/variants/lilygo_tbeam_SX1276/TBeamGpsProvider.h
new file mode 100644
index 00000000..c0b95252
--- /dev/null
+++ b/variants/lilygo_tbeam_SX1276/TBeamGpsProvider.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <helpers/sensors/MicroNMEALocationProvider.h>
+#include <LilygoTBeamSX1276Board.h>
+
+// Own the GPS main supply and UART together. The backup supply is never cut.
+// PIN_GPS_TX is the module's TX (ESP32 RX); PIN_GPS_RX is ESP32 TX.
+class TBeamGpsProvider : public MicroNMEALocationProvider {
+  LilygoTBeamSX1276Board& _board;
+  bool _started = false;
+  bool _haveFix = false;
+  uint32_t _fixAt = 0;
+  long _fixEpoch = 0;
+
+public:
+  TBeamGpsProvider(LilygoTBeamSX1276Board& board, mesh::RTCClock* clock)
+      : MicroNMEALocationProvider(Serial1, clock), _board(board) {}
+
+  void begin() override {
+    if (_started) return;
+    Serial1.end();
+    if (!_board.setGpsPower(true)) {
+      _board.setGpsPower(false); // Best-effort undo if enable/readback failed.
+      return;
+    }
+#ifdef GPS_BAUD_RATE
+    const uint32_t baud = GPS_BAUD_RATE;
+#else
+    const uint32_t baud = 9600;
+#endif
+    Serial1.begin(baud, SERIAL_8N1, PIN_GPS_TX, PIN_GPS_RX);
+    MicroNMEALocationProvider::begin();
+    MicroNMEALocationProvider::syncTime();
+    _haveFix = false;
+    _started = true;
+  }
+
+  void stop() override {
+    if (_started) MicroNMEALocationProvider::stop();
+    Serial1.end();
+    // Avoid powering an unpowered receiver through the MCU's idle-high TX.
+    pinMode(PIN_GPS_RX, INPUT);
+    pinMode(PIN_GPS_TX, INPUT);
+    _board.setGpsPower(false);
+    MicroNMEALocationProvider::syncTime();
+    _haveFix = false;
+    _started = false;
+  }
+
+  bool isEnabled() override { return _started; }
+  void sendSentence(const char* sentence) override {
+    if (_started) MicroNMEALocationProvider::sendSentence(sentence);
+  }
+  bool isValid() override {
+    return _started && _haveFix && (uint32_t)(millis() - _fixAt) <= 10000
+        && MicroNMEALocationProvider::isValid();
+  }
+
+  void loop() override {
+    if (!_started) return;
+    MicroNMEALocationProvider::loop();
+    if (MicroNMEALocationProvider::isValid()) {
+      long epoch = MicroNMEALocationProvider::getTimestamp();
+      // GGA can arrive before a dated RMC sentence. Do not accept an unset
+      // date as a fresh position/time after the receiver is power-cycled.
+      if (epoch >= 1577836800L && (!_haveFix || epoch != _fixEpoch)) {
+        _fixEpoch = epoch;
+        _fixAt = millis();
+        _haveFix = true;
+      }
+    }
+  }
+
+  void formatStatus(char* reply, size_t capacity) {
+    if (!_haveFix) {
+      snprintf(reply, capacity, "> gps=%s fix=none sats=%ld", _started ? "on" : "off", satellitesCount());
+    } else {
+      snprintf(reply, capacity, "> gps=%s fix=%s age=%lus sats=%ld", _started ? "on" : "off",
+          isValid() ? "valid" : "stale", (unsigned long)((millis() - _fixAt) / 1000), satellitesCount());
+    }
+  }
+};
