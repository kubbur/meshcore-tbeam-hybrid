diff --git a/examples/companion_radio/main.cpp b/examples/companion_radio/main.cpp
index 89f0e6cb..07ee269e 100644
--- a/examples/companion_radio/main.cpp
+++ b/examples/companion_radio/main.cpp
@@ -2,6 +2,11 @@
 #include <Mesh.h>
 #include "MyMesh.h"
 
+#ifdef ESP32_PLATFORM
+#include "esp_pm.h"
+#include "esp_bt.h"
+#endif
+
 // Believe it or not, this std C function is busted on some platforms!
 static uint32_t _atoi(const char* sp) {
   uint32_t n = 0;
@@ -242,6 +247,36 @@ void setup() {
 #endif
 
   board.onBootComplete();
+
+#ifdef ESP32_PLATFORM
+#if !CONFIG_IDF_TARGET_ESP32C6
+  // Match the BLE sleep behaviour of the original PowerSaving17 build.
+  esp_err_t errBLESleep = esp_bt_sleep_enable();
+  if (errBLESleep == ESP_OK) {
+    Serial.println("Bluetooth sleep enabled successfully");
+  } else {
+    Serial.printf("Bluetooth sleep enable failed: %s\n", esp_err_to_name(errBLESleep));
+  }
+#endif
+
+#if CONFIG_IDF_TARGET_ESP32C3
+  esp_pm_config_esp32c3_t pm_config;
+#elif CONFIG_IDF_TARGET_ESP32S3
+  esp_pm_config_esp32s3_t pm_config;
+#elif CONFIG_IDF_TARGET_ESP32
+  esp_pm_config_esp32_t pm_config;
+#elif CONFIG_IDF_TARGET_ESP32C6
+  esp_pm_config_t pm_config;
+#endif
+
+  pm_config = { .max_freq_mhz = 80, .min_freq_mhz = 40, .light_sleep_enable = true };
+  esp_err_t errPM = esp_pm_configure(&pm_config);
+  if (errPM == ESP_OK) {
+    Serial.println("Power Management configured successfully");
+  } else {
+    Serial.printf("Power Management failed to configure: %d\r\n", errPM);
+  }
+#endif
 }
 
 void loop() {
@@ -259,6 +294,10 @@ void loop() {
   if (!the_mesh.hasPendingWork()) {
 #if defined(NRF52_PLATFORM)
     board.sleep(0); // nrf ignores seconds param, sleeps whenever possible
+#elif defined(ESP32_PLATFORM) && defined(BLE_PIN_CODE)
+    if (!bluetooth_interface.isReadBusy() && !bluetooth_interface.isWriteBusy()) {
+      vTaskDelay(pdMS_TO_TICKS(10));  // allow automatic light sleep when BLE is idle
+    }
 #endif
   }
 
diff --git a/platformio.local.ini b/platformio.local.ini
index c79e681c..bf97b2c8 100644
--- a/platformio.local.ini
+++ b/platformio.local.ini
@@ -1,8 +1,10 @@
 [env:Tbeam_SX1276_companion_radio_ble_ps]
 extends = env:Tbeam_SX1276_companion_radio_ble
+; Match the PowerSaving17 firmware family originally installed on this device.
+platform_packages = platformio/framework-arduinoespressif32@https://github.com/IoTThinks/powersaving-arduino-lib/releases/download/2.0.17/esp32-2.0.17.zip
 build_flags =
   ${env:Tbeam_SX1276_companion_radio_ble.build_flags}
-  '-D FIRMWARE_VERSION="v1.17.1-hybrid"'
+  '-D FIRMWARE_VERSION="v1.17.1-hybrid-ps"'
   '-D FIRMWARE_BUILD_DATE="16 Sep 2026"'
   '-D ALLOWED_REPEAT_FREQ_RANGE={433000,433000},{869495,869495},{869618,869618},{918000,918000}'
   -D HYBRID_REMOTE_ADMIN=1
