+void MyMesh::handleAdminCommand(uint32_t sender_timestamp, char* command, char* reply) {
+  if (memcmp(command, "setperm ", 8) == 0) {
+    char* hex = &command[8];
+    char* separator = strchr(hex, ' ');
+    if (separator == NULL) {
+      strcpy(reply, "Err - bad params");
+      return;
+    }
+
+    *separator++ = 0;
+    uint8_t pubkey[PUB_KEY_SIZE];
+    int hex_len = min((int)(separator - hex - 1), PUB_KEY_SIZE * 2);
+    int key_len = hex_len / 2;
+    uint8_t permissions = atoi(separator);
+    if (!mesh::Utils::fromHex(pubkey, key_len, hex) ||
+        !admin_acl.applyPermissions(self_id, pubkey, key_len, permissions)) {
+      strcpy(reply, "Err - invalid params");
+      return;
+    }
+
+    if ((permissions & PERM_ACL_ROLE_MASK) != PERM_ACL_GUEST) {
+      seedAdminContact(mesh::Identity(pubkey));
+    }
+    dirty_admin_acl_expiry = futureMillis(HYBRID_LAZY_ACL_WRITE_DELAY);
+    strcpy(reply, "OK");
+    return;
+  }
+
+  if (strncmp(command, "set repeat", 10) == 0) {
+    if (strstr(command, "off")) {
+      strcpy(reply, "Error: repeat is locked on in hybrid firmware");
+    } else {
+      _prefs.setRepeatEn(true);
+      savePrefs();
+      strcpy(reply, "OK - repeat is locked ON");
+    }
+    return;
+  }
+  if (strcmp(command, "get repeat") == 0) {
+    strcpy(reply, "> on (locked)");
+    return;
+  }
+
+  if (strncmp(command, "set radio ", 10) == 0) {
+    uint32_t freq_khz = (uint32_t)(strtof(command + 10, NULL) * 1000.0f + 0.5f);
+    if (!isValidClientRepeatFreq(freq_khz)) {
+      strcpy(reply, "Error: frequency is not allowed for always-on repeat");
+      return;
+    }
+  }
+  if (strncmp(command, "set tx ", 7) == 0) {
+    int power = atoi(command + 7);
+    if (power < -9 || power > MAX_LORA_TX_POWER) {
+      strcpy(reply, "Error: TX power out of range");
+      return;
+    }
+  }
+
+  static const char* unsupported[] = {
+    "start ota", "tempradio ", "region", "powersaving", "log ",
+    "set flood.", "set loop.", "set int.thresh", "set cad", "set agc.reset.interval",
+    "set allow.read.only", "set adc.multiplier", "set lat ", "set lon "
+  };
+  for (const char* prefix : unsupported) {
+    if (strncmp(command, prefix, strlen(prefix)) == 0) {
+      strcpy(reply, "Error: unsupported by hybrid companion");
+      return;
+    }
+  }
+
+  admin_cli.handleCommand(sender_timestamp, command, reply);
+  _prefs.setRepeatEn(true);
+}
+
+void MyMesh::putHybridNeighbour(const mesh::Identity& id, uint32_t timestamp, float snr) {
+  uint32_t oldest = 0xFFFFFFFF;
+  HybridNeighbourInfo* target = &hybrid_neighbours[0];
+  for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+    if (id.matches(hybrid_neighbours[i].id)) {
+      target = &hybrid_neighbours[i];
+      break;
+    }
+    if (hybrid_neighbours[i].heard_timestamp < oldest) {
+      oldest = hybrid_neighbours[i].heard_timestamp;
+      target = &hybrid_neighbours[i];
+    }
+  }
+  target->id = id;
+  target->advert_timestamp = timestamp;
+  target->heard_timestamp = getRTCClock()->getCurrentTime();
+  target->snr = (int8_t)(snr * 4);
+}
+
+void MyMesh::onAdvertRecv(mesh::Packet* packet, const mesh::Identity& id, uint32_t timestamp,
+                          const uint8_t* app_data, size_t app_data_len) {
+  BaseChatMesh::onAdvertRecv(packet, id, timestamp, app_data, app_data_len);
+  if (packet->getPathHashCount() != 0) return;
+
+  AdvertDataParser parser(app_data, app_data_len);
+  if (parser.isValid() && parser.getType() == ADV_TYPE_REPEATER) {
+    putHybridNeighbour(id, timestamp, packet->getSNR());
+  }
+}
