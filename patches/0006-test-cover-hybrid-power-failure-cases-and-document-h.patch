+#include <helpers/PowerSavingUtils.h>
+#include <cassert>
+#include <cstdio>
+using namespace PowerSaving;
+int main() {
+  float fractional[] = {48.1f, 48.3f, 48.5f, 48.7f};
+  float negative[] = {-4.5f, -5.5f};
+  assert(fabs(meanTemperature(fractional, 4) - 48.4f) < 0.001f);
+  assert(meanTemperature(negative, 2) == -5.0f);
+  assert(isnan(meanTemperature(nullptr, 1)) && isnan(meanTemperature(negative, 0)));
+  for (float bad : {NAN, INFINITY, -INFINITY, -40.1f, 125.1f}) {
+    float samples[] = {20.0f, bad}; assert(isnan(meanTemperature(samples, 2)));
+  }
+  assert(idleDelay(100, false, 1000, 500, false, false) == 10);
+  assert(idleDelay(100, false, 105, 0, false, false) == 5);
+  assert(idleDelay(100, false, 0, 102, false, false) == 2);
+  assert(idleDelay(100, false, 100, 0, false, false) == 0);
+  assert(idleDelay(100, false, 99, 0, false, false) == 0);
+  assert(idleDelay(100, true, 0, 0, false, false) == 0);
+  assert(idleDelay(100, false, 0, 0, true, false) == 0);
+  assert(idleDelay(100, false, 0, 0, false, true) == 1);
+  assert(beforeDeadline(0xFFFFFFFCu, 3, 10) == 7);
+  assert(beforeDeadline(4, 0xFFFFFFFCu, 10) == 0);
+  assert(chargeMilliAmps(0) == 0 && chargeMilliAmps(8) == 200);
+  assert(chargeMilliAmps(11) == 500 && chargeMilliAmps(16) == 1000);
+  assert(chargeMilliAmps(17) == -1 && chargeMilliAmps(31) == -1);
+  assert(inputMilliAmps(1) == 500 && inputMilliAmps(4) == 1500);
+  assert(inputMilliAmps(6) == -1);
+  assert(!chargeBackoff(false, true, 40, false, false, true, 5000));
+  assert(chargeBackoff(false, true, 80, false, false, true, 5000));
+  assert(chargeBackoff(true, true, 71, false, false, true, 5000));
+  assert(!chargeBackoff(true, true, 70, false, false, true, 4750));
+  assert(chargeBackoff(false, false, 40, false, false, true, 5000));
+  assert(chargeBackoff(false, true, NAN, false, false, true, 5000));
+  assert(chargeBackoff(false, true, 40, true, false, true, 5000));
+  assert(chargeBackoff(false, true, 40, false, true, true, 5000));
+  assert(chargeBackoff(false, true, 40, false, false, true, 4499));
+  assert(chargeBackoff(true, true, 40, false, false, true, 4749));
+  assert(chargeBackoff(true, true, 40, false, false, false, 0));
+  ChargeRecovery recovery;
+  assert(recovery.limit(false, true, true, 100));
+  assert(recovery.limit(false, true, true, 60099));
+  assert(!recovery.limit(false, true, true, 60100));
+  assert(recovery.limit(true, false, true, 62000));
+  assert(recovery.limit(false, true, true, 65000));
+  assert(recovery.limit(true, true, true, 120000)); // A fault resets the timer.
+  assert(recovery.limit(false, true, true, 125000));
+  assert(recovery.limit(false, true, true, 184999));
+  assert(!recovery.limit(false, true, true, 185000));
+  ChargeRecovery wrap;
+  assert(wrap.limit(false, true, true, 0xFFFFFF00u));
+  assert(!wrap.limit(false, true, true, uint32_t(0xFFFFFF00u + 60000u)));
+  puts("PASS: temperature, charge bounds/backoff/recovery, idle deadlines and wraparound");
+}
diff --git a/tests/hybrid_power/run.py b/tests/hybrid_power/run.py
