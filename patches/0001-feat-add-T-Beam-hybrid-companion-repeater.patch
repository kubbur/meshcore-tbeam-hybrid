+void MyMesh::setTxPower(int8_t power_dbm) {
+  radio_driver.setTxPower(power_dbm);
+}
+
+void MyMesh::formatNeighborsReply(char* reply) {
+  HybridNeighbourInfo* sorted[MAX_NEIGHBOURS];
+  int count = 0;
+  for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+    if (hybrid_neighbours[i].heard_timestamp) sorted[count++] = &hybrid_neighbours[i];
+  }
+  std::sort(sorted, sorted + count, [](const HybridNeighbourInfo* a, const HybridNeighbourInfo* b) {
+    return a->heard_timestamp > b->heard_timestamp;
+  });
+
+  char* dest = reply;
+  for (int i = 0; i < count && dest - reply < 134; i++) {
+    if (i) *dest++ = '\n';
+    char hex[10];
+    mesh::Utils::toHex(hex, sorted[i]->id.pub_key, 4);
+    uint32_t seconds_ago = getRTCClock()->getCurrentTime() - sorted[i]->heard_timestamp;
+    sprintf(dest, "%s:%u:%d", hex, seconds_ago, sorted[i]->snr);
+    dest = strchr(dest, 0);
+  }
+  if (dest == reply) strcpy(dest, "-none-");
+}
+
+void MyMesh::removeNeighbor(const uint8_t* pubkey, int key_len) {
+  for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+    if (memcmp(hybrid_neighbours[i].id.pub_key, pubkey, key_len) == 0) {
+      hybrid_neighbours[i] = HybridNeighbourInfo();
+    }
+  }
+}
