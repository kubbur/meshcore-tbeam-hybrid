+#include "MyMesh.h"
+
+#ifdef HYBRID_REMOTE_ADMIN
+
+#include <algorithm>
+
+#define HYBRID_REQ_TYPE_GET_ACCESS_LIST  0x05
+#define HYBRID_REQ_TYPE_GET_NEIGHBOURS   0x06
+#define HYBRID_REQ_TYPE_GET_OWNER_INFO   0x07
+#define HYBRID_FIRMWARE_VER_LEVEL        2
+#define HYBRID_SERVER_RESPONSE_DELAY     300
+#define HYBRID_LAZY_ACL_WRITE_DELAY      5000
+
+void MyMesh::seedAdminContact(const mesh::Identity& id) {
+  if (lookupContactByPubKey(id.pub_key, PUB_KEY_SIZE)) return;
+
+  ContactInfo contact;
+  memset(&contact, 0, sizeof(contact));
+  contact.id = id;
+  contact.type = ADV_TYPE_NONE;
+  contact.out_path_len = OUT_PATH_UNKNOWN;
+  contact.lastmod = getRTCClock()->getCurrentTime();
+  addContact(contact);
+}
+
+uint8_t MyMesh::handleAdminLogin(const mesh::Identity& sender, const uint8_t* secret,
+                                 uint32_t sender_timestamp, const char* password, bool is_flood) {
+  ClientInfo* client = NULL;
+  if (password[0] == 0) {
+    client = admin_acl.getClient(sender.pub_key, PUB_KEY_SIZE);
+  }
+
+  if (client == NULL) {
+    uint8_t permissions;
+    if (_prefs.password[0] && strcmp(password, _prefs.password) == 0) {
+      permissions = PERM_ACL_ADMIN;
+    } else if (_prefs.guest_password[0] && strcmp(password, _prefs.guest_password) == 0) {
+      permissions = PERM_ACL_GUEST;
+    } else {
+      return 0;
+    }
+
+    client = admin_acl.putClient(sender, 0);
+    if (client == NULL || sender_timestamp <= client->last_timestamp) {
+      MESH_DEBUG_PRINTLN("Hybrid admin: possible login replay attack");
+      return 0;
+    }
+
+    client->last_timestamp = sender_timestamp;
+    client->last_activity = getRTCClock()->getCurrentTime();
+    client->permissions &= ~PERM_ACL_ROLE_MASK;
+    client->permissions |= permissions;
+    memcpy(client->shared_secret, secret, PUB_KEY_SIZE);
+
+    if (permissions != PERM_ACL_GUEST) {
+      dirty_admin_acl_expiry = futureMillis(HYBRID_LAZY_ACL_WRITE_DELAY);
+    }
+  }
+
+  if (is_flood) client->out_path_len = OUT_PATH_UNKNOWN;
+  seedAdminContact(sender);
+
+  uint32_t now = getRTCClock()->getCurrentTimeUnique();
+  memcpy(admin_reply_data, &now, 4);
+  admin_reply_data[4] = RESP_SERVER_LOGIN_OK;
+  admin_reply_data[5] = 0;
+  admin_reply_data[6] = client->isAdmin() ? 1 : 0;
+  admin_reply_data[7] = client->permissions;
+  getRNG()->random(&admin_reply_data[8], 4);
+  admin_reply_data[12] = HYBRID_FIRMWARE_VER_LEVEL;
+  return 13;
+}
+
+void MyMesh::onAnonDataRecv(mesh::Packet* packet, const uint8_t* secret, const mesh::Identity& sender,
+                            uint8_t* data, size_t len) {
+  if (packet->getPayloadType() != PAYLOAD_TYPE_ANON_REQ || len < 5 || len >= MAX_PACKET_PAYLOAD) return;
+
+  uint32_t sender_timestamp;
+  memcpy(&sender_timestamp, data, 4);
+  data[len] = 0;
+
+  uint8_t reply_len = handleAdminLogin(sender, secret, sender_timestamp,
+                                       reinterpret_cast<const char*>(&data[4]), packet->isRouteFlood());
+  if (reply_len == 0) return;
+
+  ContactInfo* contact = lookupContactByPubKey(sender.pub_key, PUB_KEY_SIZE);
+  if (contact == NULL) return;
+
+  if (packet->isRouteFlood()) {
+    mesh::Packet* path = createPathReturn(sender, secret, packet->path, packet->path_len,
+                                          PAYLOAD_TYPE_RESPONSE, admin_reply_data, reply_len);
+    if (path) sendFloodScoped(*contact, path, HYBRID_SERVER_RESPONSE_DELAY);
+    return;
+  }
+
+  mesh::Packet* reply = createDatagram(PAYLOAD_TYPE_RESPONSE, sender, secret, admin_reply_data, reply_len);
+  if (reply == NULL) return;
+
+  if (contact->out_path_len != OUT_PATH_UNKNOWN) {
+    sendDirect(reply, contact->out_path, contact->out_path_len, HYBRID_SERVER_RESPONSE_DELAY);
+  } else {
+    sendFloodScoped(*contact, reply, HYBRID_SERVER_RESPONSE_DELAY);
+  }
+}
