+void MyMesh::sendSelfAdvertisement(int delay_millis, bool flood) {
+  mesh::Packet* packet;
+  if (_prefs.advert_loc_policy == ADVERT_LOC_NONE) {
+    packet = createSelfAdvert(_prefs.node_name);
+  } else {
+    packet = createSelfAdvert(_prefs.node_name, sensors.node_lat, sensors.node_lon);
+  }
+  if (packet == NULL) return;
+
+  if (flood) {
+    TransportKey scope;
+    memcpy(scope.key, _prefs.default_scope_key, sizeof(scope.key));
+    sendFloodScoped(scope, packet, delay_millis);
+  } else {
+    sendZeroHop(packet, delay_millis);
+  }
+}
