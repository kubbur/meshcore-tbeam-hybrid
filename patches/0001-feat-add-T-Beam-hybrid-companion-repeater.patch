+uint8_t MyMesh::handleAdminRequest(ClientInfo* sender, uint32_t sender_timestamp,
+                                   const uint8_t* payload, size_t payload_len) {
+  memcpy(admin_reply_data, &sender_timestamp, 4);
+  if (payload_len == 0) return 0;
+
+  if (payload[0] == REQ_TYPE_GET_STATUS) {
+    HybridRepeaterStats stats;
+    stats.batt_milli_volts = board.getBattMilliVolts();
+    stats.curr_tx_queue_len = _mgr->getOutboundTotal();
+    stats.noise_floor = (int16_t)_radio->getNoiseFloor();
+    stats.last_rssi = (int16_t)radio_driver.getLastRSSI();
+    stats.n_packets_recv = radio_driver.getPacketsRecv();
+    stats.n_packets_sent = radio_driver.getPacketsSent();
+    stats.total_air_time_secs = getTotalAirTime() / 1000;
+    stats.total_up_time_secs = uptime_millis / 1000;
+    stats.n_sent_flood = getNumSentFlood();
+    stats.n_sent_direct = getNumSentDirect();
+    stats.n_recv_flood = getNumRecvFlood();
+    stats.n_recv_direct = getNumRecvDirect();
+    stats.err_events = _err_flags;
+    stats.last_snr = (int16_t)(radio_driver.getLastSNR() * 4);
+    stats.n_direct_dups = ((SimpleMeshTables*)getTables())->getNumDirectDups();
+    stats.n_flood_dups = ((SimpleMeshTables*)getTables())->getNumFloodDups();
+    stats.total_rx_air_time_secs = getReceiveAirTime() / 1000;
+    stats.n_recv_errors = radio_driver.getPacketsRecvErrors();
+    memcpy(&admin_reply_data[4], &stats, sizeof(stats));
+    return 4 + sizeof(stats);
+  }
+
+  if (payload[0] == REQ_TYPE_GET_TELEMETRY_DATA && payload_len >= 2) {
+    uint8_t permissions = ~(payload[1]);
+    if ((sender->permissions & PERM_ACL_ROLE_MASK) == PERM_ACL_GUEST) permissions = 0;
+
+    telemetry.reset();
+    telemetry.addVoltage(TELEM_CHANNEL_SELF, (float)board.getBattMilliVolts() / 1000.0f);
+    sensors.querySensors(permissions, telemetry);
+    float temperature = board.getMCUTemperature();
+    if (!isnan(temperature)) telemetry.addTemperature(TELEM_CHANNEL_SELF, temperature);
+
+    uint8_t telemetry_len = telemetry.getSize();
+    memcpy(&admin_reply_data[4], telemetry.getBuffer(), telemetry_len);
+    return 4 + telemetry_len;
+  }
+
+  if (payload[0] == HYBRID_REQ_TYPE_GET_ACCESS_LIST && sender->isAdmin() && payload_len >= 3) {
+    if (payload[1] != 0 || payload[2] != 0) return 0;
+    uint8_t offset = 4;
+    for (int i = 0; i < admin_acl.getNumClients() && offset + 7 <= sizeof(admin_reply_data); i++) {
+      ClientInfo* client = admin_acl.getClientByIdx(i);
+      if (client->permissions == 0) continue;
+      memcpy(&admin_reply_data[offset], client->id.pub_key, 6);
+      offset += 6;
+      admin_reply_data[offset++] = client->permissions;
+    }
+    return offset;
+  }
+
+  if (payload[0] == HYBRID_REQ_TYPE_GET_NEIGHBOURS && payload_len >= 11 && payload[1] == 0) {
+    uint8_t count = payload[2];
+    uint16_t offset;
+    memcpy(&offset, &payload[3], 2);
+    uint8_t order_by = payload[5];
+    uint8_t prefix_len = min(payload[6], (uint8_t)PUB_KEY_SIZE);
+
+    int16_t neighbour_count = 0;
+    HybridNeighbourInfo* sorted[MAX_NEIGHBOURS];
+    for (int i = 0; i < MAX_NEIGHBOURS; i++) {
+      if (hybrid_neighbours[i].heard_timestamp) sorted[neighbour_count++] = &hybrid_neighbours[i];
+    }
+    if (order_by == 0) {
+      std::sort(sorted, sorted + neighbour_count,
+                [](const HybridNeighbourInfo* a, const HybridNeighbourInfo* b) {
+                  return a->heard_timestamp > b->heard_timestamp;
+                });
+    } else if (order_by == 1) {
+      std::sort(sorted, sorted + neighbour_count,
+                [](const HybridNeighbourInfo* a, const HybridNeighbourInfo* b) {
+                  return a->heard_timestamp < b->heard_timestamp;
+                });
+    } else if (order_by == 2) {
+      std::sort(sorted, sorted + neighbour_count,
+                [](const HybridNeighbourInfo* a, const HybridNeighbourInfo* b) { return a->snr > b->snr; });
+    } else if (order_by == 3) {
+      std::sort(sorted, sorted + neighbour_count,
+                [](const HybridNeighbourInfo* a, const HybridNeighbourInfo* b) { return a->snr < b->snr; });
+    }
+
+    uint8_t results[130];
+    int results_len = 0;
+    uint16_t results_count = 0;
+    for (int i = 0; i < count && i + offset < neighbour_count; i++) {
+      int entry_len = prefix_len + 5;
+      if (results_len + entry_len > (int)sizeof(results)) break;
+      HybridNeighbourInfo* neighbour = sorted[i + offset];
+      uint32_t seconds_ago = getRTCClock()->getCurrentTime() - neighbour->heard_timestamp;
+      memcpy(&results[results_len], neighbour->id.pub_key, prefix_len);
+      results_len += prefix_len;
+      memcpy(&results[results_len], &seconds_ago, 4);
+      results_len += 4;
+      results[results_len++] = neighbour->snr;
+      results_count++;
+    }
+
+    int reply_offset = 4;
+    memcpy(&admin_reply_data[reply_offset], &neighbour_count, 2);
+    reply_offset += 2;
+    memcpy(&admin_reply_data[reply_offset], &results_count, 2);
+    reply_offset += 2;
+    memcpy(&admin_reply_data[reply_offset], results, results_len);
+    return reply_offset + results_len;
+  }
+
+  if (payload[0] == HYBRID_REQ_TYPE_GET_OWNER_INFO) {
+    snprintf((char*)&admin_reply_data[4], sizeof(admin_reply_data) - 4, "%s\n%s\n%s",
+             FIRMWARE_VERSION, _prefs.node_name, _prefs.owner_info);
+    return 4 + strlen((char*)&admin_reply_data[4]);
+  }
+
+  return 0;
+}
