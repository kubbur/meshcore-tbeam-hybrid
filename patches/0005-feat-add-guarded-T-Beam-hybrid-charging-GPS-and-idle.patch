diff --git a/src/helpers/esp32/TBeamPower.cpp b/src/helpers/esp32/TBeamPower.cpp
new file mode 100644
index 00000000..26d68757
--- /dev/null
+++ b/src/helpers/esp32/TBeamPower.cpp
@@ -0,0 +1,193 @@
+#if defined(TBEAM_HYBRID_POWER_V3) && defined(TBEAM_SX1276)
+
+#include "TBeamBoard.h"
+#include <Preferences.h>
+#include <helpers/PowerSavingUtils.h>
+
+// Target-specific to the classic AXP2101 board. Never reinterpret AXP192
+// registers. Unlike convenience getters, every snapshot checks I2C reads.
+bool TBeamBoard::readPmu(uint8_t reg, uint8_t* data, size_t count) {
+  if (!PMU || PMU->getChipModel() != XPOWERS_AXP2101) return false;
+  PMU_WIRE_PORT.beginTransmission(I2C_PMU_ADD);
+  PMU_WIRE_PORT.write(reg);
+  if (PMU_WIRE_PORT.endTransmission(false) != 0) return false;
+  if (PMU_WIRE_PORT.requestFrom((uint8_t)I2C_PMU_ADD, count) != count) {
+    while (PMU_WIRE_PORT.available()) PMU_WIRE_PORT.read();
+    return false;
+  }
+  for (size_t i = 0; i < count; ++i) data[i] = PMU_WIRE_PORT.read();
+  return true;
+}
+
+bool TBeamBoard::samplePower() {
+  PowerSnapshot next;
+  uint8_t adcControl, adc[10];
+  if (!readPmu(XPOWERS_AXP2101_STATUS1, next.status, 2)
+      || !readPmu(XPOWERS_AXP2101_ADC_CHANNEL_CTRL, &adcControl, 1)
+      || !readPmu(XPOWERS_AXP2101_ADC_DATA_RELUST0, adc, sizeof(adc))
+      || !readPmu(XPOWERS_AXP2101_ICC_CHG_SET, &next.chargeCode, 1)
+      || !readPmu(XPOWERS_AXP2101_INPUT_CUR_LIMIT_CTRL, &next.inputCode, 1)
+      || !readPmu(XPOWERS_AXP2101_CV_CHG_VOL_SET, &next.voltageCode, 1)
+      || !readPmu(XPOWERS_AXP2101_LDO_ONOFF_CTRL0, &next.ldo, 1)) {
+    _power.valid = false;
+    return false;
+  }
+  auto adc14 = [&adc](int i) -> uint16_t { return ((adc[i] & 0x3F) << 8) | adc[i + 1]; };
+  next.battMv = (next.status[0] & 8) ? ((adc[0] & 0x1F) << 8) | adc[1] : 0;
+  next.vbusMv = (next.status[0] & 0x20) ? adc14(4) : 0;
+  next.systemMv = adc14(6);
+  next.pmuTemperature = XPOWERS_AXP2101_CONVERSION(adc14(8));
+  next.valid = (adcControl & 0x1D) == 0x1D
+      && isfinite(next.pmuTemperature) && next.pmuTemperature >= -40.0f && next.pmuTemperature <= 125.0f
+      && PowerSaving::chargeMilliAmps(next.chargeCode) >= 0
+      && PowerSaving::inputMilliAmps(next.inputCode) >= 0;
+  next.sampledAt = millis();
+  _power = next;
+  return next.valid;
+}
+
+bool TBeamBoard::applyChargeLimit(uint8_t code) {
+  uint8_t actual = 0;
+  bool ok = PMU && PMU->getChipModel() == XPOWERS_AXP2101
+      && PMU->setChargerConstantCurr(code)
+      && readPmu(XPOWERS_AXP2101_ICC_CHG_SET, &actual, 1) && (actual & 0x1F) == code;
+  _powerWriteOk = ok;
+  return ok;
+}
+
+bool TBeamBoard::applyUsbLimit(uint16_t milliamps) {
+  // Explicit profiles, not adapter detection. 1500 mA is for the user's rated
+  // car supply; select 500 before using a USB source of unknown capability.
+  if (milliamps != 500 && milliamps != 1500) return false;
+  uint8_t code = milliamps == 1500 ? XPOWERS_AXP2101_VBUS_CUR_LIM_1500MA : XPOWERS_AXP2101_VBUS_CUR_LIM_500MA;
+  uint8_t actual = 0;
+  bool ok = PMU && PMU->getChipModel() == XPOWERS_AXP2101 && PMU->setVbusCurrentLimit(code)
+      && readPmu(XPOWERS_AXP2101_INPUT_CUR_LIMIT_CTRL, &actual, 1) && (actual & 7) == code;
+  if (ok) _usbLimitMa = milliamps;
+  _powerWriteOk = ok;
+  return ok;
+}
+
+void TBeamBoard::beginPowerV3() {
+  if (!PMU || PMU->getChipModel() != XPOWERS_AXP2101) {
+    Serial.println("Hybrid power: unsupported or missing PMU; fast charge not applied");
+    return;
+  }
+  Preferences prefs;
+  if (prefs.begin("hybrid_ps3", true)) {
+    _usbLimitMa = prefs.getUShort("usb_ma", 500);
+    prefs.end();
+  }
+  if (_usbLimitMa != 500 && _usbLimitMa != 1500) _usbLimitMa = 500;
+  bool inputOk = applyUsbLimit(_usbLimitMa);
+  uint8_t adcControl = 0;
+  bool adcOk = PMU->enableTemperatureMeasure()
+      && readPmu(XPOWERS_AXP2101_ADC_CHANNEL_CTRL, &adcControl, 1) && (adcControl & 0x1D) == 0x1D;
+  uint8_t voltage = 0;
+  bool voltageOk = readPmu(XPOWERS_AXP2101_CV_CHG_VOL_SET, &voltage, 1) && (voltage & 7) == XPOWERS_AXP2101_CHG_VOL_4V2;
+  _chargeVoltageOk = voltageOk;
+  // Never request fast charging when voltage or input setup is unverified.
+  bool chargeOk = applyChargeLimit(voltageOk ? (inputOk && adcOk ? XPOWERS_AXP2101_CHG_CUR_1000MA
+      : XPOWERS_AXP2101_CHG_CUR_500MA) : 0);
+  _powerConfigOk = inputOk && chargeOk && adcOk && voltageOk;
+  _chargeLimited = !_powerConfigOk;
+  _powerWriteOk = _powerConfigOk;
+  _nextPowerSample = millis() + 2000; // Let the ADC settle without delaying RX.
+  Serial.printf("Hybrid power: target=1000mA USB-limit=%umA CV-target=4.2V config=%s; battery-temp=unavailable\n",
+      _usbLimitMa, _powerConfigOk ? "verified" : "ERROR");
+  Serial.println("Hybrid power: screen=manual GPS=rail-controlled deep-sleep=disabled/unvalidated repeat=always");
+}
+
+bool TBeamBoard::setGpsPower(bool enabled) {
+  if (!PMU || PMU->getChipModel() != XPOWERS_AXP2101) return false;
+  bool ok = enabled ? PMU->enablePowerOutput(XPOWERS_ALDO3) : PMU->disablePowerOutput(XPOWERS_ALDO3);
+  uint8_t value = 0;
+  return ok && readPmu(XPOWERS_AXP2101_LDO_ONOFF_CTRL0, &value, 1) && ((value & 4) != 0) == enabled;
+}
+
+void TBeamBoard::loopPowerV3() {
+  if (!PMU || PMU->getChipModel() != XPOWERS_AXP2101 || (int32_t)(millis() - _nextPowerSample) < 0) return;
+  _nextPowerSample = millis() + 5000;
+  bool valid = samplePower();
+  bool limited = !_powerConfigOk || PowerSaving::chargeBackoff(_chargeLimited, valid, _power.pmuTemperature,
+      (_power.status[0] & 2) != 0, (_power.status[0] & 1) != 0 || (_power.status[1] & 8) != 0,
+      (_power.status[0] & 0x20) != 0, _power.vbusMv);
+  limited = _chargeRecovery.limit(limited, _chargeLimited, valid && (_power.status[0] & 0x20), millis());
+  uint8_t code = limited ? XPOWERS_AXP2101_CHG_CUR_500MA : XPOWERS_AXP2101_CHG_CUR_1000MA;
+  // A known wrong charge voltage is not a reason merely to reduce current.
+  if (valid && (_power.voltageCode & 7) != XPOWERS_AXP2101_CHG_VOL_4V2) _chargeVoltageOk = false;
+  if (!valid || !_chargeVoltageOk) {
+    code = 0;
+    limited = true;
+    if (!_chargeVoltageOk) _powerConfigOk = false;
+  }
+  _chargeLimited = limited; // Requested protection state; actual current is read separately.
+  if (!valid || (_power.chargeCode & 0x1F) != code) {
+    if (applyChargeLimit(code)) {
+      // Do not claim the old snapshot still represents a new setting.
+      _power.valid = false;
+    }
+  }
+}
+
+bool TBeamBoard::handlePowerCommand(const char* command, char* reply, size_t capacity) {
+  if (strcmp(command, "get protections") == 0) {
+    const uint8_t registers[] = {XPOWERS_AXP2101_DIE_TEMP_CTRL, XPOWERS_AXP2101_CHARGE_GAUGE_WDT_CTRL,
+        XPOWERS_AXP2101_ITERM_CHG_SET_CTRL, XPOWERS_AXP2101_CV_CHG_VOL_SET, XPOWERS_AXP2101_THE_REGU_THRES_SET,
+        XPOWERS_AXP2101_CHG_TIMEOUT_SET_CTRL};
+    uint8_t values[sizeof(registers)];
+    for (size_t i = 0; i < sizeof(registers); ++i) {
+      if (!readPmu(registers[i], &values[i], 1)) {
+        snprintf(reply, capacity, "Error: protection register read failed; no settings changed");
+        return true;
+      }
+    }
+    snprintf(reply, capacity, "> raw PMU 13=%02X 18=%02X 63=%02X 64=%02X 65=%02X 67=%02X; battery_temp=unavailable",
+        values[0], values[1], values[2], values[3], values[4], values[5]);
+  } else if (strcmp(command, "get sleep") == 0) {
+    snprintf(reply, capacity, "> deep=disabled: retained-state/RX wake unvalidated; BLE stays available; repeat=always");
+  } else if (strcmp(command, "get idle") == 0) {
+    snprintf(reply, capacity, "> task_yields=%lu yielded_ms=%lu (not sleep residency); CPU_now=%uMHz",
+        (unsigned long)_yieldCalls, (unsigned long)_yieldMillis, getCpuFrequencyMhz());
+  } else if (strncmp(command, "set usb limit ", 14) == 0) {
+    const char* value = command + 14;
+    uint16_t limit = strcmp(value, "500") == 0 ? 500 : strcmp(value, "1500") == 0 ? 1500 : 0;
+    if (!limit) {
+      snprintf(reply, capacity, "Error: use set usb limit 500 or 1500 (rated supply only)");
+    } else if (!applyUsbLimit(limit)) {
+      snprintf(reply, capacity, "Error: USB limit write/readback failed; current state unknown");
+    } else {
+      Preferences prefs;
+      bool saved = prefs.begin("hybrid_ps3", false);
+      if (saved) { saved = prefs.putUShort("usb_ma", limit) == sizeof(uint16_t); prefs.end(); }
+      _power.valid = false;
+      snprintf(reply, capacity, saved ? "OK USB input limit=%umA saved; battery target=1000mA" : "Error: limit=%umA applied but NOT saved", limit);
+    }
+  } else if (strcmp(command, "get power") == 0 || strcmp(command, "get charge") == 0
+      || strcmp(command, "get temps") == 0 || strcmp(command, "get rails") == 0) {
+    if (!_power.valid) {
+      snprintf(reply, capacity, "> PMU sample unavailable; config=%s last_write=%s battery_temp=unavailable",
+          _powerConfigOk ? "verified" : "ERROR", _powerWriteOk ? "OK" : "ERROR");
+    } else if (strcmp(command, "get power") == 0) {
+      snprintf(reply, capacity, "> VBUS=%umV batt=%umV sys=%umV dir=%u phase=%u age=%lums",
+          _power.vbusMv, _power.battMv, _power.systemMv, (_power.status[1] >> 5) & 3,
+          _power.status[1] & 7, (unsigned long)(millis() - _power.sampledAt));
+    } else if (strcmp(command, "get charge") == 0) {
+      snprintf(reply, capacity, "> target=1000mA read=%dmA USB=%dmA backoff=%u thermal=%u input=%u write=%s (limits; not measured)",
+          PowerSaving::chargeMilliAmps(_power.chargeCode), PowerSaving::inputMilliAmps(_power.inputCode), _chargeLimited,
+          (_power.status[0] >> 1) & 1, ((_power.status[0] & 1) != 0) || ((_power.status[1] & 8) != 0),
+          _powerWriteOk ? "OK" : "ERROR");
+    } else if (strcmp(command, "get temps") == 0) {
+      snprintf(reply, capacity, "> MCU_uncal=%.1fC PMU_die=%.1fC battery=unavailable ambient=unavailable",
+          getMCUTemperature(), _power.pmuTemperature);
+    } else {
+      snprintf(reply, capacity, "> GPS_ALDO3=%u radio_ALDO2=%u GPS_backup=unchanged screen=manual",
+          (_power.ldo >> 2) & 1, (_power.ldo >> 1) & 1);
+    }
+  } else {
+    return false;
+  }
+  return true;
+}
+
+#endif
