diff --git a/src/helpers/PowerSavingUtils.h b/src/helpers/PowerSavingUtils.h
index d54ace99..ab881ec7 100644
--- a/src/helpers/PowerSavingUtils.h
+++ b/src/helpers/PowerSavingUtils.h
@@ -52,7 +52,10 @@ inline bool chargeBackoff(bool wasLimited, bool valid, float pmuTemperature,
   if (!valid || !isfinite(pmuTemperature)) return true;
   if (!external) return wasLimited;
   if (thermalLimited || inputLimited || pmuTemperature >= 80.0f || vbusMv < 4500) return true;
-  if (wasLimited && (pmuTemperature > 70.0f || vbusMv < 4750)) return true;
+  // No separate 4.75 V recovery gate: it held a healthy 4.66 V input at
+  // 500 mA indefinitely. Keep the 4.5 V floor above, temperature hysteresis
+  // and the full-minute healthy-sample recovery delay below.
+  if (wasLimited && pmuTemperature > 70.0f) return true;
   return false;
 }
 
diff --git a/tests/hybrid_power/admin_test.cpp b/tests/hybrid_power/admin_test.cpp
new file mode 100644
index 00000000..99750c58
--- /dev/null
+++ b/tests/hybrid_power/admin_test.cpp
@@ -0,0 +1,67 @@
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+using std::min;
+constexpr int PUB_KEY_SIZE = 32, MAX_LORA_TX_POWER = 20;
+constexpr uint8_t PERM_ACL_ROLE_MASK = 3, PERM_ACL_GUEST = 0;
+constexpr uint32_t HYBRID_LAZY_ACL_WRITE_DELAY = 1000;
+uint32_t futureMillis(uint32_t delay) { return delay; }
+namespace mesh {
+struct Identity { explicit Identity(const uint8_t*) {} };
+struct Utils { static bool fromHex(uint8_t*, int, const char*) { return false; } };
+}
+struct FakePrefs {
+  bool enabled = true;
+  void setRepeatEn(bool value) { enabled = value; }
+};
+struct FakeACL {
+  bool applyPermissions(int, const uint8_t*, int, uint8_t) { return false; }
+};
+struct FakeCLI {
+  int calls = 0;
+  void handleCommand(uint32_t, char*, char* reply) { ++calls; strcpy(reply, "delegated"); }
+};
+struct FakeBoard { bool handlePowerCommand(const char*, char*, size_t) { return false; } } board;
+struct FakeNMEA { void formatStatus(char* reply, size_t) { strcpy(reply, "> gps=off"); } } nmea;
+class MyMesh {
+public:
+  FakePrefs _prefs;
+  FakeACL admin_acl;
+  FakeCLI admin_cli;
+  int self_id = 0, saves = 0;
+  uint32_t dirty_admin_acl_expiry = 0;
+  void savePrefs() { ++saves; _prefs.setRepeatEn(true); }
+  void seedAdminContact(const mesh::Identity&) {}
+  bool isValidClientRepeatFreq(uint32_t frequency) { return frequency == 869618; }
+  void handleAdminCommand(uint32_t sender_timestamp, char* command, char* reply);
+};
+// Execute the full production dispatcher, including tag reflection and locks.
+// The test substitutes dependencies; it is not an RF/authentication test.
+#include "admin_method.inc"
+
+int main() {
+  MyMesh node;
+  auto check = [&node](const char* request, const char* expected) {
+    char command[160], reply[160]{};
+    strcpy(command, request);
+    node.handleAdminCommand(123, command, reply);
+    assert(strcmp(reply, expected) == 0);
+    assert(node._prefs.enabled);
+  };
+  check("get repeat", "> on");
+  check("01|get repeat", "01|> on");
+  check("  AF|get repeat", "AF|> on");
+  assert(node.saves == 0 && node.admin_cli.calls == 0);
+  check("set repeat off", "Error: repeat is locked on in hybrid firmware");
+  check("02|set repeat off", "02|Error: repeat is locked on in hybrid firmware");
+  assert(node.saves == 0);
+  check("03|set repeat on", "03|OK - repeat is locked ON");
+  assert(node.saves == 1);
+  check("04|get repeat", "04|> on");
+  check("05|ver", "05|delegated");
+  assert(node.admin_cli.calls == 1);
+  puts("PASS: actual remote-admin dispatcher emits canonical on, reflects tags, preserves repeat lock and delegates unchanged commands");
+}
diff --git a/tests/hybrid_power/pmu_test.cpp b/tests/hybrid_power/pmu_test.cpp
index 87ab18fe..96785c22 100644
--- a/tests/hybrid_power/pmu_test.cpp
+++ b/tests/hybrid_power/pmu_test.cpp
@@ -124,6 +124,35 @@ int main() {
   nowMs += 5000; board.loopPowerV3(); assert(PMU_WIRE_PORT.regs[0x62] == 0); // Latched until restart.
   healthy(); TBeamBoard badBoot; badBoot.PMU = &pmu; PMU_WIRE_PORT.failReg = 0x64;
   badBoot.beginPowerV3(); assert(!badBoot._powerConfigOk && PMU_WIRE_PORT.regs[0x62] == 0);
+  // Reproduce the user's 4.658-4.671 V readings after a hardware-limit event.
+  // Recovery must no longer require the unrelated 4.75 V threshold.
+  for (uint16_t mv : {4500, 4658, 4659, 4670, 4671, 4749}) {
+    healthy(); FakePMU recoveryPmu; TBeamBoard recovery; recovery.PMU = &recoveryPmu;
+    recovery.beginPowerV3();
+    assert(recovery.handlePowerCommand("set usb limit 1500", reply, sizeof(reply)));
+    adc(0x38, mv);
+    PMU_WIRE_PORT.regs[0] |= 1; // Hardware input limiting initially requests backoff.
+    nowMs = 2000; recovery.loopPowerV3();
+    assert(PMU_WIRE_PORT.regs[0x62] == 11 && recovery._chargeLimited);
+    PMU_WIRE_PORT.regs[0] &= ~1;
+    for (int i = 0; i < 12; ++i) {
+      nowMs += 5000; recovery.loopPowerV3();
+      assert(PMU_WIRE_PORT.regs[0x62] == 11 && recovery._chargeLimited);
+    }
+    nowMs += 5000; recovery.loopPowerV3();
+    assert(PMU_WIRE_PORT.regs[0x62] == 16 && !recovery._chargeLimited);
+    nowMs += 5000; recovery.loopPowerV3();
+    recovery.handlePowerCommand("get charge", reply, sizeof(reply));
+    assert(strstr(reply, "read=1000mA USB=1500mA backoff=0"));
+    assert(strstr(reply, "limits; not measured"));
+    // A subsequent low-input event still reduces the limit and needs fresh recovery.
+    adc(0x38, 4499); nowMs += 5000; recovery.loopPowerV3();
+    assert(PMU_WIRE_PORT.regs[0x62] == 11 && recovery._chargeLimited);
+    adc(0x38, mv); nowMs += 5000; recovery.loopPowerV3();
+    assert(PMU_WIRE_PORT.regs[0x62] == 11 && recovery._chargeLimited);
+    for (int i = 0; i < 12; ++i) { nowMs += 5000; recovery.loopPowerV3(); }
+    assert(PMU_WIRE_PORT.regs[0x62] == 16 && !recovery._chargeLimited);
+  }
   healthy(); pmu.model = 2; TBeamBoard other; other.PMU = &pmu;
   int writes = pmu.chargeWrites; other.beginPowerV3(); other.loopPowerV3();
   assert(pmu.chargeWrites == writes && !other.setGpsPower(true));
