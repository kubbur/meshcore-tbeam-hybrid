--- /dev/null
+++ b/tests/hybrid_power/run.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""Host tests; fake I/O is NOT proof of board current, rails or RF operation."""
+import pathlib
+import re
+import subprocess
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+HERE = pathlib.Path(__file__).resolve().parent
+
+
+def method(source, signature):
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        if source[end] == "{":
+            depth += 1
+        elif source[end] == "}":
+            depth -= 1
+        end += 1
+    return source[start:end] + "\n"
+
+
+with tempfile.TemporaryDirectory(prefix="meshcore-ps3-tests-") as folder:
+    out = pathlib.Path(folder)
+    ui = (ROOT / "examples/companion_radio/ui-new/UITask.cpp").read_text()
+    (out / "display_methods.inc").write_text(method(ui, "void UITask::newMsg(") + method(ui, "char UITask::checkDisplayOn("))
+    board = (ROOT / "src/helpers/esp32/TBeamBoard.h").read_text()
+    blocks = re.findall(r"#ifdef TBEAM_HYBRID_POWER_V3\n(.*?)#endif", board, re.S)
+    assert len(blocks) == 2
+    (out / "power_board.inc").write_text("class TBeamBoard : public FakeBase { public: FakePMU* PMU = nullptr;\n" + "\n".join(blocks) + "\n};\n")
+    power = (ROOT / "src/helpers/esp32/TBeamPower.cpp").read_text()
+    (out / "power_methods.inc").write_text(re.sub(r"^#include .*\n", "", power, flags=re.M))
+    cases = [("policy", []), ("gps", []), ("display", ["-DTBEAM_HYBRID_POWER_V3=1"]), ("display", []),
+             ("pmu", ["-DTBEAM_HYBRID_POWER_V3=1", "-DTBEAM_SX1276=1"])]
+    for index, (case, defines) in enumerate(cases):
+        binary = out / f"test-{index}"
+        subprocess.run(["/usr/bin/c++", "-std=c++17", "-Wall", "-Wextra", "-Werror",
+                        "-Wno-unused-parameter", "-include", "initializer_list", *defines,
+                        "-I", str(HERE / "mocks"), "-I", str(ROOT / "src"),
+                        "-I", str(ROOT / "variants/lilygo_tbeam_SX1276"), "-I", str(out),
+                        "-I", str(ROOT / ".pio/libdeps/Tbeam_SX1276_companion_radio_ble_ps/XPowersLib/src"),
+                        str(HERE / f"{case}_test.cpp"), "-o", str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+# Check integration invariants in real source separately from behavioral tests.
+mesh = (ROOT / "examples/companion_radio/MyMesh.cpp").read_text()
+forward = method(mesh, "bool MyMesh::allowPacketForward(")
+assert re.search(r"#ifdef HYBRID_ALWAYS_REPEAT\s+return true;", forward)
+assert "isConnected" not in forward
+raw = method(mesh, "void MyMesh::logRxRaw(")
+assert "_serial->isConnected()" in raw and "snr" in raw and "rssi" in raw
+ini = (ROOT / "platformio.local.ini").read_text()
+assert "-D HYBRID_ALWAYS_REPEAT=1" in ini and "{869618,869618}" in ini
+assert "-D HYBRID_REMOTE_ADMIN=1" in ini and "ADV_TYPE_REPEATER" in ini
+assert "powersaving-arduino-lib/releases/download/2.0.17" in ini
+print("PASS: integration guards retain forwarding with BLE, raw mapping feed, 869.618 MHz, hybrid admin and ps framework", flush=True)
